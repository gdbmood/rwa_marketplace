# Supabase project URL, from the Supabase dashboard under Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=""
# Supabase anon (publishable) key for browser reads, Project Settings > API
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Supabase service role key, server only, bypasses RLS, Project Settings > API
SUPABASE_SERVICE_ROLE_KEY=""
# Supabase JWT signing secret used to mint RLS tokens, Project Settings > API > JWT Settings
SUPABASE_JWT_SECRET=""

# Get your client id from the thirdweb dashboard: https://thirdweb.com/create-api-key
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=""
# Get your secret key from the thirdweb dashboard: https://thirdweb.com/create-api-key
THIRDWEB_SECRET_KEY=""

# EVM chain id the marketplace contracts are deployed on, e.g. 137 for Polygon
NEXT_PUBLIC_THIRDWEB_CHAIN_ID=""
# Deployed RWA marketplace contract address on the chain above
NEXT_PUBLIC_THIRDWEB_CONTRACT_ADDRESS=""
# USDC token contract address on the chain above
NEXT_PUBLIC_USDC_CONTRACT_ADDRESS=""
# Block explorer base URL for transaction links, e.g. https://polygonscan.com
NEXT_PUBLIC_BLOCKCHAIN_EXPLORER_URL=""
# SIWE domain shown in wallet sign-in prompts, must match the site hostname
NEXT_PUBLIC_THIRDWEB_AUTH_DOMAIN=""

# EVM private key that signs SIWE payloads and session JWTs, generate a dedicated key and keep it secret
AUTH_PRIVATE_KEY=""

# Sumsub app token from the Sumsub dashboard under Dev space > App tokens
SUMSUB_TOKEN=""
# Sumsub app token secret, shown once when the app token is created
SUMSUB_SECRET_KEY=""
# Sumsub webhook signing secret, set in the Sumsub dashboard webhook configuration
SUMSUB_WEBHOOK_SECRET=""

# RPC endpoint the chain indexer polls for contract events, from your node provider
INDEXER_RPC_URL=""
# Shared secret the chain webhook endpoint requires from the indexer, generate a long random string
CHAIN_WEBHOOK_SECRET=""
# API key for exchangerate-api.com used by the currency rate action
EXCHANGE_RATE_API_KEY=""

# Secret set on the thirdweb dashboard webhook for /api/onramp/webhook, verifies x-payload signatures
THIRDWEB_WEBHOOK_SECRET=""
# Optional: thirdweb onramp sub-provider, one of coinbase (default), stripe, transak
THIRDWEB_ONRAMP_PROVIDER=""
# Optional: bearer secret Vercel cron sends to /api/indexer/run and /api/indexer/sweep
CRON_SECRET=""

# Test mode (never set in production): enables /api/test-auth and the mock onramp provider
TEST_MODE=""
# Test mode for the browser bundle: local test wallet instead of the thirdweb in-app wallet
NEXT_PUBLIC_TEST_MODE=""

# Optional indexer tuning (sensible defaults apply when unset)
# First block the indexer scans when no cursor exists yet
INDEXER_START_BLOCK=""
# Confirmations to wait before ingesting a block
INDEXER_CONFIRMATIONS=""
# Maximum blocks fetched per indexer cycle
INDEXER_MAX_BLOCKS=""
# Maximum chain events processed per indexer cycle
INDEXER_MAX_EVENTS=""
# Poll interval in milliseconds for the long-running scripts/indexer.ts loop
INDEXER_POLL_MS=""
# Optional: accounts funded by contracts/scripts/deploy_local.ts on a local chain
FUND_ACCOUNTS=""
# Optional local chain (31337) overrides for the deployed contract addresses
NEXT_PUBLIC_LOCAL_MARKETPLACE_ADDRESS=""
NEXT_PUBLIC_LOCAL_USDC_ADDRESS=""
