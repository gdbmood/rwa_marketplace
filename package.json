    "@mui/material-nextjs": "^6.4.3",
    "@sumsub/websdk-react": "^2.3.13",
    "@supabase/supabase-js": "^2.114.0",
    "axios": "^1.8.1",
    "jose": "^6.0.10",
    "next": "15.1.12",
    "pino-pretty": "^13.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^14.3.8",
